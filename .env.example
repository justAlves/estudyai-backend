PORT=3333
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estudeai
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-development-secret-with-at-least-32-characters
GOOGLE_CLIENT_ID=
LOG_LEVEL=info
LOG_PRETTY=true
OTEL_SERVICE_NAME=estudeai-api
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# NVIDIA NIM é tentado primeiro para gerações textuais; Gemini fica como fallback
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-20b

# Notificações e recuperação de senha por e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=EstudyAI <onboarding@resend.dev>
RESEND_REPLY_TO=

# Opcionais: Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Opcionais: Cloudflare R2 para editais/redações em arquivo
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
