{
  "name": "estudeai-api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:e2e": "E2E_DATABASE_URL=\"$E2E_DATABASE_URL\" bun test e2e",
    "test:all": "bun test src e2e",
    "dev": "bun run --watch src/index.ts",
    "worker:plans": "bun run src/workers/plan.worker.ts",
    "worker:materials": "bun run src/workers/material.worker.ts",
    "worker:rag": "bun run src/workers/rag-ingestion.worker.ts",
    "worker:simulations": "bun run src/workers/simulation.worker.ts",
    "rag:check": "bun run src/workers/rag-ingestion.worker.test.ts",
    "rag:syllabus": "bun run scripts/import-syllabus-rag.ts",
    "rag:notices": "bun run scripts/index-notices-rag.ts",
    "rag:search:check": "bun run src/modules/rag/services/rag.service.test.ts",
    "study:check": "bun run src/modules/study/services/material.service.test.ts",
    "study:adaptive:check": "bun run src/modules/study/services/adaptive-plan.service.test.ts",
    "study:scheduling:check": "bun run src/modules/study/services/task-scheduling.service.test.ts",
    "collect": "bun run scripts/collect/run.ts",
    "collect:legacy": "bun run scripts/collect/run.ts --all",
    "collect:help": "bun run scripts/collect.ts",
    "collect:discover": "bun run scripts/collect/discover.ts",
    "collect:pdf": "bun run scripts/collect/import-pdf.ts",
    "collect:check": "bun run scripts/collect/import-pdf.test.ts",
    "collect:notices": "bun run scripts/collect-notices.ts",
    "collect:notices:check": "bun run scripts/collect-notices.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@elysia/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
